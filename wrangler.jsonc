{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openresearch-club-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "api.openresearch.club", "custom_domain": true },
    { "pattern": "openresearch.club", "custom_domain": true },
    { "pattern": "www.openresearch.club", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openresearch-club",
      "database_id": "e7d12ec4-5ed8-429c-a9f5-a7cd7f435a8c",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "openscience" }],
  "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "QuotaAgent" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuotaAgent"] }],
  "vars": {
    "PUBLIC_BASE": "https://api.openresearch.club",
    "DATA_HOST": "https://data.openresearch.club",
    "ABUSE_CONTACT": "abuse@openresearch.club",
    "SITE_PREFIX": "false"
  },
  "triggers": { "crons": ["23 3 * * *"] },
  "observability": { "enabled": true }
}
